#!/usr/bin/env bash
# apply-udev-live.sh - Version 1.0
# Interactive selection to reload and trigger UDEV rules on live nodes via SSH.

set -u

# --- CONFIGURATION ---
# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

# --- 1. NODE STATUS QUERY ---
echo -e "${BLUE}[INFO] Querying Kubernetes for worker node status...${NC}"
RAW_NODES=$(kubectl get nodes -l node-role.kubernetes.io/worker=)
mapfile -t ALL_NODES < <(echo "$RAW_NODES" | awk 'NR>1 {print $1}')

if [[ ${#ALL_NODES[@]} -eq 0 ]]; then
    echo -e "${RED}[ERROR] No worker nodes found via kubectl.${NC}"
    exit 1
fi

# --- 2. DISPLAY STATUS TABLE ---
echo -e "\n${CYAN}Cluster Worker Node Status:${NC}"
echo -e "${BLUE}-----------------------------------------------------------------------${NC}"
echo "$RAW_NODES"
echo -e "${BLUE}-----------------------------------------------------------------------${NC}"

# --- 3. SELECTION MENU ---
echo -e "${YELLOW}Select Nodes to Apply UDEV Rules (Live Trigger):${NC}"
for i in "${!ALL_NODES[@]}"; do
    node="${ALL_NODES[$i]}"
    # Parse status to show if node is Ready
    node_status=$(echo "$RAW_NODES" | grep "^${node} " | awk '{print $2}')
    hint=$([[ "$node_status" == "Ready" ]] && echo -e "${GREEN}(Ready)${NC}" || echo -e "${RED}($node_status)${NC}")
    
    printf "%2d) %-20s %b\n" "$((i+1))" "$node" "$hint"
done
echo -e " a) ALL Worker Nodes"
echo -e " q) Quit"

read -p ">> Selection (e.g., 1,2 or 'a'): " choice

# --- 4. SELECTION PROCESSING ---
SELECTED_NODES=()

if [[ "$choice" == "a" ]]; then
    SELECTED_NODES=("${ALL_NODES[@]}")
elif [[ "$choice" == "q" || -z "$choice" ]]; then
    echo -e "${BLUE}Action cancelled.${NC}"
    exit 0
else
    # Parse comma-separated input (Standard across your toolkit)
    IFS=',' read -ra ADDR <<< "$choice"
    for idx in "${ADDR[@]}"; do
        idx=$(echo "$idx" | tr -d ' ') # Remove whitespace
        if [[ "$idx" =~ ^[0-9]+$ ]] && [ "$idx" -le "${#ALL_NODES[@]}" ] && [ "$idx" -gt 0 ]; then
            SELECTED_NODES+=("${ALL_NODES[$((idx-1))]}")
        fi
    done
fi

# Final check before execution
if [[ ${#SELECTED_NODES[@]} -eq 0 ]]; then
    echo -e "${RED}[ERROR] No valid nodes selected.${NC}"
    exit 1
fi

# --- 5. EXECUTION ---
echo -e "\n${BLUE}[INFO] Applying live UDEV reload to selected nodes...${NC}"

for node in "${SELECTED_NODES[@]}"; do
    echo -e "${BLUE}>>> Node: $node${NC}"
    
    # Run udev commands via SSH
    # reload-rules: tells udevd to pick up new files in /etc/udev/rules.d/
    # trigger: tells the kernel to re-send 'add' events for network interfaces
    # settle: waits for the event queue to empty before proceeding
    if ssh -o BatchMode=yes -o StrictHostKeyChecking=no "$node" \
       "sudo udevadm control --reload-rules && \
        sudo udevadm trigger --action=add --subsystem-match=net && \
        sudo udevadm settle" 2>/dev/null; then
        echo -e "    ${GREEN}[OK]${NC} Rules reloaded and network devices re-triggered."
    else
        echo -e "    ${RED}[FAILED]${NC} SSH connection or command execution failed on $node."
    fi
done

echo -e "\n${GREEN}[SUCCESS] Live UDEV trigger sequence complete.${NC}"
